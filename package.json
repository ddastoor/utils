    "libarchive.js": "^2.0.2",
    "libheif-js": "^1.23.5",
    "lucide-static": "^1.73.0",
    "mediabunny": "^1.66.0",
    "mermaid": "^12.3.0",
    "mupdf": "^1.28.6",
    "openpgp": "^6.3.2",
    "prettier": "^3.10.1",
