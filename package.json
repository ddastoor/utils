{
  "name": "utils",
  "version": "1.0.0",
  "description": "Private, in-browser utilities. Files never leave your device.",
  "scripts": {
    "prepare": "node scripts/vendor.mjs && node scripts/gen-icons.mjs",
    "predev": "node scripts/vendor.mjs && node scripts/gen-icons.mjs",
    "dev": "vite",
    "prebuild": "node scripts/vendor.mjs && node scripts/gen-icons.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tests/search.test.mjs && node tests/expr.test.mjs",
    "docs": "node scripts/gen-toollist.mjs",
    "test:e2e": "node tests/security.e2e.mjs && node tests/pgp.e2e.mjs && node tests/calc.e2e.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddastoor/utils.git"
  },
