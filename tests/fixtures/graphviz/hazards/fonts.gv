//// the PostScript font names Graphviz knows, with their weights and slants
digraph ps { node [shape=box]; a [fontname="Helvetica" label="Helvetica text"]; b [fontname="Helvetica-Bold" label="Helvetica-Bold text"]; c [fontname="Helvetica-Oblique" label="Helvetica-Oblique text"]; d [fontname="Helvetica-BoldOblique" label="Helvetica-BoldOblique"]; e [fontname="Helvetica-Narrow" label="Helvetica-Narrow text"]; f [fontname="Times-Roman" label="Times-Roman text"]; g [fontname="Times-Bold" label="Times-Bold text"]; h [fontname="Times-Italic" label="Times-Italic text"]; i [fontname="Times-BoldItalic" label="Times-BoldItalic text"]; j [fontname="Courier" label="Courier text"]; k [fontname="Courier-Bold" label="Courier-Bold text"]; l [fontname="Courier-Oblique" label="Courier-Oblique"]; m [fontname="Courier-BoldOblique" label="Courier-BoldOblique"]; a -> b -> c -> d -> e; f -> g -> h -> i; j -> k -> l -> m }
////
digraph ps2 { node [shape=box]; a [fontname="AvantGarde-Book" label="AvantGarde-Book"]; b [fontname="AvantGarde-Demi" label="AvantGarde-Demi"]; c [fontname="Bookman-Light" label="Bookman-Light"]; d [fontname="Bookman-DemiItalic" label="Bookman-DemiItalic"]; e [fontname="NewCenturySchlbk-Roman" label="NewCenturySchlbk-Roman"]; f [fontname="Palatino-BoldItalic" label="Palatino-BoldItalic"]; g [fontname="Symbol" label="Symbol abc"]; h [fontname="ZapfChancery-MediumItalic" label="ZapfChancery"]; i [fontname="ZapfDingbats" label="ZapfDingbats"]; a -> b -> c -> d -> e -> f -> g -> h -> i }
//// family names as people type them
digraph families { node [shape=box]; a [fontname="Arial" label="Arial text"]; b [fontname="Times New Roman" label="Times New Roman text"]; c [fontname="Courier New" label="Courier New text"]; d [fontname="Verdana" label="Verdana text"]; e [fontname="Georgia" label="Georgia text"]; f [fontname="sans-serif" label="sans-serif text"]; g [fontname="monospace" label="monospace text"]; h [fontname="No Such Font 123" label="unknown font"]; i [fontname="Arial Bold" label="Arial Bold text"]; j [fontname="Noto Sans Devanagari" label="नोटो सैन्स"]; k [fontname="" label="empty font name"]; a -> b -> c -> d -> e -> f -> g -> h -> i -> j -> k }
//// sizes
digraph sizes { a [fontsize=1 label="size 1"]; b [fontsize=6 label="size 6"]; c [fontsize=14 label="size 14"]; d [fontsize=36 label="size 36"]; e [fontsize=100 label="100"]; f [fontsize=0 label="size 0"]; g [fontsize=14.5 label="14.5"]; a -> b -> c -> d -> e -> f -> g }
//// which names go into the SVG
digraph svgnames { fontnames=svg; node [shape=box]; a [fontname="Helvetica-Bold" label="Helvetica-Bold"]; b [fontname="Times-Italic" label="Times-Italic"]; c [fontname="Courier" label="Courier"]; a -> b -> c }
////
digraph psnames { fontnames=ps; node [shape=box]; a [fontname="Helvetica-Bold" label="Helvetica-Bold"]; b [fontname="Times-Italic" label="Times-Italic"]; c [fontname="Courier" label="Courier"]; a -> b -> c }
//// fonts of graph, cluster and edge labels
digraph places { fontname="Helvetica-Bold"; fontsize=20; label="Graph label"; subgraph cluster_c { fontname="Courier"; fontsize=10; label="cluster label"; a } a -> b [fontname="Times-Italic" fontsize=18 label="edge label"]; node [fontname="Helvetica"] c; b -> c }
//// widths that the tables hold: all of printable ASCII
digraph ascii { node [shape=box fontname="Helvetica"]; a [label=" !\"#$%&'()*+,-./0123456789:;<=>?"]; b [label="@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_"]; c [label="`abcdefghijklmnopqrstuvwxyz{|}~"]; d [fontname="Times-Roman" label="iiiiiiiiii WWWWWWWWWW"]; e [fontname="Courier" label="iiiiiiiiii WWWWWWWWWW"]; a -> b -> c -> d -> e }
